# rhp has no release numbers (progress is counted in stages; see rhp_STAGE), so a find_package()
# that asks for a version never matches. A package built for another target is refused too.

if(PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION "@RHP_STAGE@ (rhp has no release numbers; call find_package(rhp) without a version)")
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
    return()
endif()
set(PACKAGE_VERSION_COMPATIBLE TRUE)

set(rhp_msvc_abi OFF)
if(MSVC)
    set(rhp_msvc_abi ON)
endif()

if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@")
    set(PACKAGE_VERSION "built for @CMAKE_SYSTEM_NAME@")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
elseif(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P STREQUAL "@CMAKE_SIZEOF_VOID_P@")
    math(EXPR rhp_bits "@CMAKE_SIZEOF_VOID_P@ * 8")
    set(PACKAGE_VERSION "built for ${rhp_bits}-bit targets")
    unset(rhp_bits)
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
elseif(NOT "@RHP_PACKAGE_ANDROID_ABI@" STREQUAL "" AND NOT CMAKE_ANDROID_ARCH_ABI STREQUAL "@RHP_PACKAGE_ANDROID_ABI@")
    set(PACKAGE_VERSION "built for the Android ABI @RHP_PACKAGE_ANDROID_ABI@")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
elseif(CMAKE_CXX_COMPILER_LOADED AND NOT rhp_msvc_abi STREQUAL "@RHP_PACKAGE_MSVC_ABI@")
    set(PACKAGE_VERSION "built for another C++ ABI (MSVC: @RHP_PACKAGE_MSVC_ABI@)")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
unset(rhp_msvc_abi)
