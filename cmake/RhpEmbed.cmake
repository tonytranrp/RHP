include_guard(GLOBAL)

# rhp_embed_text(<output.cpp> NAMESPACE <ns> FUNCTION <fn> HEADER <header> PREFIX <chunk prefix>
#                [BASE_DIR <dir>] FILES <files...>)
#
# Writes a .cpp defining `std::span<const <ns>::lua_source> <ns>::<fn>() noexcept` with the bytes of
# every file (in order) and its chunk name (<prefix><file name>). It includes <header>, which declares
# <ns>::lua_source and the function. Regenerated at configure time when a file changes
# (CMAKE_CONFIGURE_DEPENDS), and only rewritten when the text differs.
#
# With BASE_DIR <dir>, a file's name is its path relative to <dir> ("specs/a_spec.lua") instead of
# its file name.
function(rhp_embed_text output)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "NAMESPACE;FUNCTION;PREFIX;HEADER;BASE_DIR" "FILES")
    set(arrays "")
    set(entries "")
    set(index 0)
    foreach(file IN LISTS arg_FILES)
        if(arg_BASE_DIR)
            file(RELATIVE_PATH name "${arg_BASE_DIR}" "${file}")
        else()
            get_filename_component(name "${file}" NAME)
        endif()
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # One byte array per file (string literals have length limits on MSVC).
        string(APPEND arrays "constexpr unsigned char k_source_${index}[] = {${bytes}0x00};\n")
        string(APPEND entries "    lua_source{\"${arg_PREFIX}${name}\", std::string_view{reinterpret_cast<const char*>(k_source_${index}), ${size}}},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        math(EXPR index "${index} + 1")
    endforeach()
    set(content "// Generated by cmake/RhpEmbed.cmake from the files listed in the module's CMakeLists.txt: edit those.\n#include <span>\n#include <string_view>\n\n#include <${arg_HEADER}>\n\nnamespace ${arg_NAMESPACE} {\n\nnamespace {\n${arrays}\nconst lua_source k_sources[] = {\n${entries}};\n\n} // namespace\n\nstd::span<const lua_source> ${arg_FUNCTION}() noexcept {\n    return k_sources;\n}\n\n} // namespace ${arg_NAMESPACE}\n")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
endfunction()
