{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "architecture": { "value": "x64", "strategy": "external" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Windows" ] }
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows · MSVC",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
        },
        {
            "name": "windows-msvc-asan",
            "displayName": "Windows · MSVC · AddressSanitizer",
            "inherits": "windows-msvc",
            "cacheVariables": { "RHP_SANITIZE": "address" }
        },
        {
            "name": "windows-clang-cl",
            "displayName": "Windows · clang-cl",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_C_COMPILER": "clang-cl", "CMAKE_CXX_COMPILER": "clang-cl" }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux · Clang",
            "inherits": "linux-base",
            "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
        },
        {
            "name": "linux-clang-asan",
            "displayName": "Linux · Clang · ASan + UBSan",
            "inherits": "linux-clang",
            "cacheVariables": { "RHP_SANITIZE": "address;undefined" }
        },
        {
            "name": "linux-clang-tsan",
            "displayName": "Linux · Clang · TSan",
            "inherits": "linux-clang",
            "cacheVariables": { "RHP_SANITIZE": "thread", "RHP_TLS_OPENSSL": "OFF" }
        },
        {
            "name": "linux-clang-fuzz",
            "displayName": "Linux · Clang · libFuzzer + ASan/UBSan",
            "inherits": "linux-clang",
            "cacheVariables": { "RHP_SANITIZE": "address;undefined", "RHP_FUZZ": "ON", "RHP_BUILD_EXAMPLES": "OFF", "RHP_BUILD_TOOLS": "OFF" }
        },
        {
            "name": "macos",
            "displayName": "macOS · AppleClang (universal)",
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3"
            }
        },
        {
            "name": "ios-base",
            "hidden": true,
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "16.3",
                "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
                "CMAKE_XCODE_EMIT_EFFECTIVE_PLATFORM_NAME": "OFF",
                "RHP_BUILD_TOOLS": "OFF"
            }
        },
        {
            "name": "ios-sim",
            "displayName": "iOS · Simulator",
            "inherits": "ios-base",
            "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphonesimulator", "CMAKE_CROSSCOMPILING_EMULATOR": "${sourceDir}/Tools/ios/simctl_run.sh" }
        },
        {
            "name": "ios-device",
            "displayName": "iOS · Device (build only)",
            "inherits": "ios-base",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "iphoneos",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "RHP_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "android-base",
            "hidden": true,
            "inherits": "base",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_static",
                "RHP_BUILD_TOOLS": "OFF"
            }
        },
        {
            "name": "android-x64",
            "displayName": "Android · x86_64 (emulator tests)",
            "inherits": "android-base",
            "cacheVariables": { "ANDROID_ABI": "x86_64" }
        },
        {
            "name": "android-arm64",
            "displayName": "Android · arm64-v8a (build only)",
            "inherits": "android-base",
            "cacheVariables": { "ANDROID_ABI": "arm64-v8a", "RHP_BUILD_TESTS": "OFF" }
        }
    ],
    "buildPresets": [
        { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Debug" },
        { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan", "configuration": "Debug" },
        { "name": "windows-clang-cl", "configurePreset": "windows-clang-cl", "configuration": "Debug" },
        { "name": "linux-clang", "configurePreset": "linux-clang", "configuration": "Debug" },
        { "name": "linux-clang-asan", "configurePreset": "linux-clang-asan", "configuration": "Debug" },
        { "name": "linux-clang-tsan", "configurePreset": "linux-clang-tsan", "configuration": "Debug" },
        { "name": "linux-clang-fuzz", "configurePreset": "linux-clang-fuzz", "configuration": "RelWithDebInfo" },
        { "name": "macos", "configurePreset": "macos", "configuration": "Debug" },
        { "name": "ios-sim", "configurePreset": "ios-sim", "configuration": "Debug" },
        { "name": "ios-device", "configurePreset": "ios-device", "configuration": "Debug" },
        { "name": "android-x64", "configurePreset": "android-x64", "configuration": "Debug" },
        { "name": "android-arm64", "configurePreset": "android-arm64", "configuration": "Debug" }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "configuration": "Debug",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "windows-msvc", "inherits": "test-base", "configurePreset": "windows-msvc" },
        { "name": "windows-msvc-asan", "inherits": "test-base", "configurePreset": "windows-msvc-asan" },
        { "name": "windows-clang-cl", "inherits": "test-base", "configurePreset": "windows-clang-cl" },
        { "name": "linux-clang", "inherits": "test-base", "configurePreset": "linux-clang" },
        { "name": "linux-clang-asan", "inherits": "test-base", "configurePreset": "linux-clang-asan" },
        { "name": "linux-clang-tsan", "inherits": "test-base", "configurePreset": "linux-clang-tsan" },
        { "name": "macos", "inherits": "test-base", "configurePreset": "macos" },
        { "name": "ios-sim", "inherits": "test-base", "configurePreset": "ios-sim" }
    ]
}
